generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profiles {
  id            String         @id
  username      String?        @unique
  role          Role           @default(STUDENT)
  banned        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  avatar        String?
  bio           String?
  fullname      String?
  phone         String?
  email         String         @unique
  affiliations  Affiliations[]
  commissions   Commissions[]
  enrollments   Enrollments[]
  gamifications  Gamifications?
  notifications  Notifications[]  @relation("UserNotifications")
  sentNotifications Notifications[] @relation("SentNotifications")
  orders         Orders[]
  products       Products[]
  achievements   UserAchievement[]

  @@map("Profiles")
}

model Notifications {
  id        String   @id @default(uuid())
  userId    String
  senderId  String?
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      Profiles @relation("UserNotifications", fields: [userId], references: [id])
  sender    Profiles? @relation("SentNotifications", fields: [senderId], references: [id])

  @@index([userId])
  @@map("Notifications")
}

model Products {
  id                  String         @id @default(uuid())
  title               String
  description         String
  price               Float
  thumbnail           String?
  producerId          String
  status              ProductStatus  @default(DRAFT)
  affiliateEnabled    Boolean        @default(false)
  commissionRate      Float?
  affiliateCookieDays Int            @default(30)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  affiliations        Affiliations[]
  enrollments         Enrollments[]
  orders              Orders[]
  producer            Profiles       @relation(fields: [producerId], references: [id])

  @@index([producerId])
  @@index([status])
}

model Affiliations {
  id           String        @id @default(uuid())
  productId    String
  affiliateId  String
  commissionId String
  code         String        @unique
  affiliate    Profiles      @relation(fields: [affiliateId], references: [id])
  product      Products      @relation(fields: [productId], references: [id])
  commissions  Commissions[]
}

model Orders {
  id          String        @id @default(uuid())
  productId   String
  buyerId     String
  total       Float
  createdAt   DateTime      @default(now())
  commissions Commissions[]
  buyer       Profiles      @relation(fields: [buyerId], references: [id])
  product     Products      @relation(fields: [productId], references: [id])
}

model Commissions {
  id            String           @id @default(uuid())
  profileId     String?
  orderId       String
  affiliationId String
  amount        Float
  status        CommissionStatus
  affiliation   Affiliations     @relation(fields: [affiliationId], references: [id])
  order         Orders           @relation(fields: [orderId], references: [id])
  profile       Profiles?        @relation(fields: [profileId], references: [id])
}

model Gamifications {
  userId    String   @id
  xp        Int
  level     Int
  createdAt DateTime @default(now())
  user      Profiles @relation(fields: [userId], references: [id])
}

model Achievement {
  id          String            @id @default(uuid())
  key         String            @unique
  title       String
  description String
  icon        String
  xpReward    Int               @default(0)
  role        Role
  createdAt   DateTime          @default(now())
  users       UserAchievement[]
}

model UserAchievement {
  id            String            @id @default(uuid())
  userId        String
  achievementId String
  status        AchievementStatus @default(LOCKED)
  progress      Int               @default(0)
  unlockedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          Profiles          @relation(fields: [userId], references: [id])
  achievement   Achievement       @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

enum AchievementStatus {
  UNLOCKED
  IN_PROGRESS
  LOCKED
}

model Enrollments {
  id        String   @id @default(uuid())
  productId String
  userId    String
  progress  Int
  product   Products @relation(fields: [productId], references: [id])
  user      Profiles @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

enum Role {
  STUDENT
  CREATOR
  AFFILIATE
  ADMIN
}

enum ProductStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum CommissionStatus {
  PENDING
  PAID
  REJECTED
  CANCELED
}
